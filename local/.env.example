# Template — copy to .env and fill in your real values:
#     cp local/.env.example local/.env
# (.env is gitignored; this example file IS meant to be committed.)

# Weekly Plan Web App deployment URL + sync key (from GAS Script Properties)
WEBAPP_URL=https://script.google.com/macros/s/<DEPLOY_ID>/exec
SYNC_AUTH_KEY=<your_sync_auth_key>
SINCE=20260101

# "open Weekly Plan" link on the diary page. Get it once with:
#   curl -sL "$WEBAPP_URL?view=links&k=$SYNC_AUTH_KEY"
WEEKLY_PLAN_URL=https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit

# SQLite (relative to the local/ folder)
DB_PATH=bot.db

# Location / timezone (used by enrich_diary.py for the Open-Meteo call)
LAT=53.3498
LON=-6.2603
WEATHER_TZ=Europe/Dublin

# No LLM settings: the diary's LLM enrichment was removed 2026-10-17 to cut
# cost. The pipeline is stdlib + Open-Meteo only, so no model/key is needed.
# (LITELLM_* entries may still sit in your real .env; they are just unused.)
